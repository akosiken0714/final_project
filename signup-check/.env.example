APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PhineWash shop settings (see config/laundry.php)
# ---------------------------------------------------------------------------
SHOP_NAME="PhineWash Laundry Services"
SHOP_ADDRESS="Poblacion, Anahawan, Southern Leyte"
# Exact spot of the shop (right-click the shop in Google Maps to copy these two numbers)
SHOP_LAT=10.2667
SHOP_LNG=125.0167
DELIVERY_MAX_KM=5

# First admin account, created by `php artisan db:seed`. Use a long, unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments.
# "demo" = pretend GCash. It ONLY works when APP_ENV is local or testing. On a live site it is switched
# off automatically and customers can only pay cash, until a real gateway is added.
PAYMENT_DRIVER=demo
# Demo code for local testing only. Leave this out of the live .env.
PAYMENT_DEMO_CODE=123456

# ---------------------------------------------------------------------------
# LIVE SITE (production) checklist: see docs/PRODUCTION-CHECKLIST.md
#   APP_ENV=production   APP_DEBUG=false   APP_URL=https://your-domain
#   SESSION_SECURE_COOKIE=true   SESSION_ENCRYPT=true   LOG_LEVEL=warning
#   a real MAIL_MAILER (not "log")   no PAYMENT_DEMO_CODE
# ---------------------------------------------------------------------------

